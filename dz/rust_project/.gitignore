# Сгенерированные файлы Cargo
/target/
**/*.rs.bk

# Файлы конфигурации IDE
.vscode/
.idea/
*.swp
*.swo

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файлы с данными приложения (если не хотите коммитить тестовые данные)
tasks.json
*.log

# Файлы профилирования
*.profraw

# Файлы покрытия кода
*.gcda
*.gcno
/coverage/

# Файлы документов, сгенерированные cargo doc
/doc/

# Временные файлы
*.tmp
*.temp
